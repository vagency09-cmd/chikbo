{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--workspace",
        "apps/web"
      ],
      "port": 5173,
      "autoPort": true,
      "env": {
        "VITE_PROXY_TARGET": "https://api.chikbo.com"
      }
    },
    {
      "name": "admin",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--workspace",
        "apps/admin"
      ],
      "port": 5174,
      "autoPort": true,
      "env": {
        "VITE_PROXY_TARGET": "https://api.chikbo.com"
      }
    },
    {
      "name": "api",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--workspace",
        "apps/api"
      ],
      "port": 4000
    }
  ]
}
